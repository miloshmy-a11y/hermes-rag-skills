# Exclude the large cached community-skill browse index (not user content)
.hub/

# Never commit credentials or local env files
.env
*.env
.env.*
secrets.*
credentials.*

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Large binary artifacts (keep skills as text/source)
*.pdf
*.zip
*.png
*.jpg
